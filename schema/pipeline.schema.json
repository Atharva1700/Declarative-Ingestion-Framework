{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declarative ingestion pipeline",
  "type": "object",
  "required": ["pipeline"],
  "additionalProperties": false,
  "properties": {
    "pipeline": {
      "type": "object",
      "required": ["name", "version", "nodes"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$"},
        "version": {"type": "integer", "minimum": 1},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "kind", "type"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$"},
              "kind": {"enum": ["source", "transform", "sink"]},
              "type": {"type": "string", "minLength": 1},
              "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "options": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
